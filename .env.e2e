# =============================================================================
# LXP5 Inference Service - E2E Test Environment
# =============================================================================
# This file contains SAFE DEFAULTS for E2E testing and CI/CD pipelines.
# It is tracked in version control and MUST NOT contain real secrets.
#
# Purpose:
#   - Provide working defaults for automated testing
#   - Enable CI/CD pipelines to run without manual configuration
#   - Document expected E2E test configuration
#
# Usage:
#   - Automatically loaded by scripts/e2e_test.py
#   - Can be overridden by .env for local testing with real API keys
#
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API Configuration
# -----------------------------------------------------------------------------
# E2E tests require a real OpenAI API key to function
# Set this in your local .env file or CI/CD secrets
# DO NOT commit real API keys here
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Speech-to-Text (STT) Configuration
# -----------------------------------------------------------------------------
# Use local Whisper for E2E tests to avoid API costs
STT_MODE=local

# Use smaller model for faster E2E tests
# Note: Accuracy may be lower, but sufficient for testing pipeline
WHISPER_MODEL=base

# -----------------------------------------------------------------------------
# Quiz Generation Configuration
# -----------------------------------------------------------------------------
# Use cost-effective model for E2E tests
QUIZ_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Vector Store Configuration
# -----------------------------------------------------------------------------
# Use separate ChromaDB directory for E2E tests to avoid polluting dev data
CHROMA_PERSIST_PATH=.test_chroma_data

# -----------------------------------------------------------------------------
# E2E Testing Configuration
# -----------------------------------------------------------------------------
# Service URL for E2E tests (assumes local development server)
SERVICE_URL=http://localhost:8000

# Callback receiver URL for E2E tests
CALLBACK_URL=http://127.0.0.1:9909/callback

# Sample audio file path for E2E tests
SAMPLE_AUDIO=inputs/sample.webm
