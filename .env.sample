# =============================================================================
# LXP5 Inference Service - Environment Variables Template
# =============================================================================
# This is a TEMPLATE file for local development. Copy this to `.env` and fill
# in your actual values. NEVER commit real secrets to version control.
#
# Quick Start:
#   1. Copy this file: cp .env.sample .env
#   2. Fill in your OpenAI API key and other values
#   3. Adjust paths and models as needed
#
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API Configuration
# -----------------------------------------------------------------------------
# Required for STT (Speech-to-Text) API mode and Quiz generation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------------------------------
# Speech-to-Text (STT) Configuration
# -----------------------------------------------------------------------------
# STT mode: "local" (Whisper local) or "api" (OpenAI API)
# Default: "local"
STT_MODE=local

# Whisper model for local STT mode
# Options: tiny, base, small, medium, large, large-v2, large-v3
# Default: "large-v3"
# Note: Larger models are more accurate but slower and require more memory
WHISPER_MODEL=large-v3

# -----------------------------------------------------------------------------
# Quiz Generation Configuration
# -----------------------------------------------------------------------------
# OpenAI model for quiz generation
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Default: "gpt-4o-mini"
# Note: gpt-4o-mini is cost-effective; gpt-4o is more capable but higher cost
QUIZ_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Vector Store Configuration
# -----------------------------------------------------------------------------
# ChromaDB persistent storage path
# Default: ".chroma_data"
# Note: This directory will be created automatically if it doesn't exist
CHROMA_PERSIST_PATH=.chroma_data

# -----------------------------------------------------------------------------
# Embedding Configuration (Optional)
# -----------------------------------------------------------------------------
# Device for embedding computation
# Options: "auto" (default), "cpu", "cuda"
# Default: "auto"
# Note: "auto" uses CUDA if available, otherwise CPU
#       "cpu" forces CPU computation (useful for reducing VRAM pressure on 8GB systems)
#       "cuda" forces CUDA with fallback to CPU if unavailable
# WARNING: Changes require service restart to take effect
EMBEDDING_DEVICE=auto

# Batch size for embedding operations
# Default: 64
# Range: 1-64 (values outside this range are clamped)
# Note: Larger batch sizes are faster but use more memory
#       Reduce to 32 or lower if experiencing VRAM issues
# WARNING: Changes require service restart to take effect
EMBEDDING_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# Chunking Configuration (Optional)
# -----------------------------------------------------------------------------
# Silence threshold for grouping segments (seconds)
# Default: 2.0
# Note: Segments with gaps <= this value are grouped together
CHUNK_SILENCE_THRESHOLD_SECONDS=2.0

# Maximum tokens per chunk
# Default: 800
# WARNING: Changing this value changes chunk boundaries and can invalidate
# existing embeddings/index. For repeatable quiz-only regeneration, keep this
# value stable per dataset unless you intend to re-index.
CHUNK_MAX_TOKENS=800

# Overlap tokens between chunks
# Default: 160
# WARNING: Changing this value changes chunk boundaries and can invalidate
# existing embeddings/index. For repeatable quiz-only regeneration, keep this
# value stable per dataset unless you intend to re-index.
CHUNK_OVERLAP_TOKENS=160

# -----------------------------------------------------------------------------
# E2E Testing Configuration (Optional)
# -----------------------------------------------------------------------------
# These are only needed when running E2E tests (scripts/e2e_test.py)

# Service URL for E2E tests
# Default: "http://localhost:8000"
SERVICE_URL=http://localhost:8000

# Callback URL for E2E tests
# Default: "http://127.0.0.1:9909/callback"
CALLBACK_URL=http://127.0.0.1:9909/callback

# Sample audio file path for E2E tests
# Default: "inputs/sample.webm"
SAMPLE_AUDIO=inputs/sample.webm

# -----------------------------------------------------------------------------
# Advanced Configuration (Optional)
# -----------------------------------------------------------------------------
# Override default env file location (if needed)
# The env loader will look for .env and .env.e2e by default
# Use this to specify a custom env file path
# INFERENCE_ENV_FILE=/path/to/custom.env
